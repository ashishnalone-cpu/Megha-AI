# Copy this to .streamlit/secrets.toml for LOCAL testing of the cloud LLM path
# (that real file is gitignored -- never commit actual keys).
#
# On Streamlit Community Cloud, you do NOT create this file at all --
# instead paste the same key = "value" lines into:
#   App settings -> Secrets   (in the Streamlit Cloud dashboard)

LLM_PROVIDER = "anthropic"        # "anthropic", "openai", or "ollama" (ollama only works on your own machine)
ANTHROPIC_API_KEY = "sk-ant-..."  # required if LLM_PROVIDER = "anthropic"
# OPENAI_API_KEY = "sk-..."       # required if LLM_PROVIDER = "openai"
